# docker compose 配置，复制为 .env 后修改
# 镜像版本：latest 或具体版本号，如 0.2.0
AHUB_VERSION=latest
# 宿主机监听地址和端口（只想本机访问时 AHUB_BIND=127.0.0.1）
AHUB_BIND=0.0.0.0
AHUB_PORT=7788
# agent 访问 Hub 用的地址（写进接入提示词和 ahub.tgz 安装命令），一般是这台机器的局域网 IP
AHUB_PUBLIC_URL=
# agent 多少分钟没有任何请求算离线
AHUB_OFFLINE_AFTER=30
# 数据存放位置：默认命名卷 ahub-data；填宿主机路径（如 ./data）则直接挂载该目录，需要 uid 1000 可写
AHUB_DATA_DIR=
# 固定负责人令牌（可选），不填则首次启动时自动生成
AHUB_OWNER_TOKEN=
TZ=Asia/Shanghai
