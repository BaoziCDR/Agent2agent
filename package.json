{
  "name": "agent2agent-hub",
  "version": "1.1.0",
  "description": "多 Agent 协作中枢：负责人发布和管理任务，Codex、Claude Code 等 agent 领取任务、汇报进度、互相协作",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "ahub": "dist/cli/ahub.js"
  },
  "files": [
    "dist",
    "web/dist",
    "skill",
    "examples"
  ],
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "prepare": "npm run build",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "vite build web",
    "dev:web": "vite web",
    "start": "node dist/cli/ahub.js serve",
    "test": "npm run build:server && node --test --test-reporter=spec test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^10.1.7",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fastify": "^5.12.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
